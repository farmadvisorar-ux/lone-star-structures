---
import site from '../data/site.json';
import types from '../data/building-types.json';
import pb from '../data/portable-buildings.json';
import { phoneLive, phoneHref } from '../lib/contact';

const groups = [...new Set(types.map((t: any) => t.group))];
const byGroup = (g: string) => types.filter((t: any) => t.group === g && !t.parent);

const pbCats = (pb as any).categories;
const pbByCat = (slug: string) => (pb as any).products.filter((x: any) => x.category === slug);
---

<header class="site-header">
  <a href="#main" class="skip">Skip to content</a>
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M3 28 L3 16 L11 11 L11 6 L21 6 L21 11 L29 16 L29 28 Z" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linejoin="round"/>
        <path d="M13 28 L13 20.5 L19 20.5 L19 28" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linejoin="round"/>
      </svg>
      <span class="brand__text">
        <strong>Lone Star</strong> Structures
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <div class="nav__item has-menu">
        <button class="nav__link" aria-expanded="false">Steel Buildings</button>
        <div class="mega">
          <div class="mega__inner">
            {groups.map((g) => (
              <div class="mega__col">
                <h3 class="mega__head">{g}</h3>
                <ul>
                  {byGroup(g).map((t: any) => (
                    <li><a href={`/building-types/${t.slug}/`}>{t.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="mega__col mega__col--all">
              <a class="mega__all" href="/building-types/">All steel building types &rarr;</a>
              <p class="mega__note">Engineered kits, stamped for your jurisdiction, shipped nationwide.</p>
              {/* Condensed caps make a seven-item top bar wider than the header
                  can hold, so these two live here rather than being shrunk to
                  illegibility. They are in the footer as well. */}
              <ul class="mega__extra">
                <li><a href="/options-and-finishes/">Options &amp; Finishes</a></li>
                <li><a href="/service-area/">Service Area</a></li>
                <li><a href="/models/">Building Models</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="nav__item has-menu">
        <button class="nav__link" aria-expanded="false">Portable Buildings</button>
        <div class="mega">
          <div class="mega__inner mega__inner--pb">
            {pbCats.map((c: any) => (
              <div class="mega__col">
                <h3 class="mega__head">{c.name}</h3>
                <ul>
                  {pbByCat(c.slug).map((x: any) => (
                    <li><a href={`/portable-buildings/${x.slug}/`}>{x.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="mega__col mega__col--all">
              <a class="mega__all" href="/portable-buildings/">All portable buildings &rarr;</a>
              <p class="mega__note">Delivered finished in TX, LA, MO, IL, TN and IN.</p>
            </div>
          </div>
        </div>
      </div>
      <a class="nav__link" href="/inventory/">Inventory</a>
      <a class="nav__link" href="/resources/">Resources</a>
      <a class="nav__link" href="/about/">About</a>
      {phoneLive && (
        <a class="nav__tel" href={phoneHref} aria-label={`Call ${site.phone}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14"><path fill="currentColor" d="M3.7 1.2 5.5.9c.4-.1.8.1 1 .5l1 2.3c.1.3.1.7-.2.9l-1.2 1a8.6 8.6 0 0 0 4.3 4.3l1-1.2c.2-.3.6-.3.9-.2l2.3 1c.4.2.6.6.5 1l-.3 1.8c-.1.4-.5.7-.9.7A12.6 12.6 0 0 1 3 2.1c0-.4.3-.8.7-.9Z"/></svg>
          <span>{site.phone}</span>
        </a>
      )}
      <a class="btn btn--primary nav__cta" href="/quote/">Get a Quote</a>
    </nav>
  </div>
</header>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--accent); color: var(--accent-contrast);
    padding: 0.75rem 1.25rem; text-decoration: none; font-weight: 600;
  }
  .skip:focus { left: 0; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--border);
  }
  .header-inner { display: flex; align-items: center; gap: 1.5rem; min-height: 78px; }

  .brand { display: flex; align-items: center; gap: 0.625rem; text-decoration: none; color: var(--text); flex-shrink: 0; }
  .brand__mark { width: 30px; height: 30px; color: var(--accent); }
  .brand__text {
    font-family: var(--font-display); font-weight: 500;
    font-size: 1.125rem; letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--text-muted);
  }
  .brand__text strong { font-weight: 600; color: var(--text); }

  .nav { display: flex; align-items: center; gap: 0.0625rem; margin-left: auto; }
  .nav__link {
    display: inline-block; padding: 0.5rem 0.5625rem;
    font-family: var(--font-display); font-weight: 500;
    font-size: 0.78125rem; letter-spacing: 0.06em; text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none; color: var(--text-muted);
    background: none; border: none; cursor: pointer; border-radius: 0;
  }
  .nav__link:hover { color: var(--accent); }
  .nav__cta { margin-left: 0.75rem; padding: 0.6875rem 1.25rem; white-space: nowrap; }
  .nav__tel {
    display: inline-flex; align-items: center; gap: 0.4375rem;
    padding: 0.5rem 0.625rem; margin-left: 0.25rem;
    font-family: var(--font-display); font-weight: 500;
    font-size: 0.875rem; letter-spacing: 0.04em; white-space: nowrap;
    text-decoration: none; color: var(--text); border-radius: 0;
  }
  .nav__tel:hover { color: var(--accent); }
  .nav__tel svg { color: var(--accent); flex-shrink: 0; }

  /* Static, so the panel below positions against the header and can run the
     full width of the viewport instead of floating under one nav item. */
  .nav__item { position: static; }
  .mega {
    position: absolute; top: 100%; left: 0; right: 0;
    transform: translateY(-4px);
    opacity: 0; visibility: hidden; transition: opacity .16s, transform .16s, visibility .16s;
    background: var(--bg-raised);
    border-top: 1px solid var(--accent);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.75rem, 3vw, 2.75rem) var(--gutter);
  }
  .has-menu:hover .mega, .has-menu:focus-within .mega { opacity: 1; visibility: visible; transform: translateY(0); }
  .mega__inner {
    display: grid; grid-template-columns: repeat(6, minmax(140px, 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    max-width: var(--maxw); margin-inline: auto;
  }
  .mega__inner--pb { grid-template-columns: repeat(5, minmax(140px, 1fr)); }
  .mega__col--all { border-left: 1px solid var(--border); padding-left: 1.25rem; }
  .mega__all { font-size: 0.875rem; font-weight: 600; color: var(--accent); text-decoration: none; display: block; margin-bottom: 0.5rem; }
  .mega__note { font-size: 0.75rem; color: var(--text-faint); line-height: 1.5; }
  .mega__extra { list-style: none; padding: 1rem 0 0; margin-top: 1rem; border-top: 1px solid var(--border); }
  .mega__extra li { margin-bottom: 0.375rem; }
  .mega__extra a {
    font-family: var(--font-display); font-weight: 500;
    font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); text-decoration: none;
  }
  .mega__extra a:hover { color: var(--accent); }
  .mega__head {
    font-family: var(--font-display); font-weight: 500;
    font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--accent); margin-bottom: 0.875rem;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);
  }
  .mega ul { list-style: none; padding: 0; }
  .mega li { margin-bottom: 0.375rem; }
  .mega a { font-size: 0.875rem; color: var(--text-muted); text-decoration: none; }
  .mega a:hover { color: var(--accent); }

  .nav-toggle { display: none; }

  @media (max-width: 1180px) {
    .nav-toggle {
      display: grid; place-items: center; margin-left: auto;
      width: 40px; height: 40px; background: none;
      border: 1px solid var(--border); border-radius: var(--radius); cursor: pointer;
    }
    .nav-toggle__bar, .nav-toggle__bar::before, .nav-toggle__bar::after {
      content: ''; display: block; width: 18px; height: 2px; background: var(--text); position: relative;
    }
    .nav-toggle__bar::before { position: absolute; top: -6px; }
    .nav-toggle__bar::after { position: absolute; top: 6px; }

    .nav {
      position: fixed; inset: 78px 0 auto 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg-raised); border-bottom: 1px solid var(--border);
      padding: 1rem var(--gutter) 1.5rem;
      max-height: calc(100dvh - 78px); overflow-y: auto;
      display: none;
    }
    .nav[data-open="true"] { display: flex; }
    .nav__link { padding: 0.75rem 0; border-bottom: 1px solid var(--border); text-align: left; width: 100%; }
    .nav__cta { margin: 1rem 0 0; justify-content: center; }
    .nav__tel { padding: 0.75rem 0; border-bottom: 1px solid var(--border); margin-left: 0; }
    .mega {
      position: static; transform: none; opacity: 1; visibility: visible;
      box-shadow: none; border: none; padding: 0.5rem 0 1rem; width: auto; display: none;
    }
    .has-menu[data-open="true"] .mega { display: block; }
    .mega__inner, .mega__inner--pb { grid-template-columns: 1fr; gap: 1rem; }
    .mega__col--all { border-left: none; padding-left: 0; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', String(!open));
    toggle.setAttribute('aria-expanded', String(!open));
  });
  // mobile: tap "Building Types" to expand rather than navigate
  document.querySelectorAll('.has-menu > .nav__link').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (window.innerWidth > 1180) return;
      e.preventDefault();
      const item = btn.parentElement as HTMLElement;
      const open = item.getAttribute('data-open') === 'true';
      item.setAttribute('data-open', String(!open));
      btn.setAttribute('aria-expanded', String(!open));
    });
  });
</script>
